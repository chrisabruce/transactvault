# TransactVault environment configuration

# Server — ports avoid the usual suspects (3000/8000/9000) so TransactVault
# can coexist with whatever else you have running locally.
APP_NAME=TransactVault
BASE_URL=http://localhost:37420
HOST=0.0.0.0
PORT=37420
PRETTY_LOGS=true
RUST_LOG=info,transactvault=debug

# SurrealDB
#   - surrealkv://./surreal-data/tv.db   embedded, file-backed (recommended dev)
#   - rocksdb://./surreal-data/tv.db     embedded, RocksDB backend
#   - mem://                             ephemeral, in-process (fastest tests)
#   - ws://127.0.0.1:37422               remote server (docker compose)
SURREAL_URL=surrealkv://./surreal-data/tv.db
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=transactvault
SURREAL_DB=app

# JWT — change in production! 64+ character random string recommended.
JWT_SECRET=change-me-to-a-long-random-secret-please-please-please
JWT_EXPIRY_HOURS=168

# Super-admins — comma-separated emails granted /admin/* access. Anyone
# whose login email is in this list gets the cross-brokerage user list and
# the audit log. Leave blank to disable the admin panel entirely.
SUPERADMIN_EMAILS=

# Email-verification window. New signups have this many hours to click the
# verify link before it expires.
VERIFICATION_EXPIRY_HOURS=24

# Password-reset link lifetime, in hours. Keep this short — the link is a
# bearer credential that grants account takeover, so it should outlive a
# slow inbox and nothing more.
RESET_EXPIRY_HOURS=1

# How many reverse proxies sit in front of the app. Only the last
# this-many X-Forwarded-For entries are trusted when resolving the client
# IP for rate limiting; a spoofed header can't win. 1 = the standard
# single-Traefik deployment; 0 = app exposed directly (forwarding headers
# ignored entirely).
TRUSTED_PROXY_HOPS=1

# Anti-abuse on the /signup form:
#   POW_DIFFICULTY_BITS — number of leading zero bits the browser must
#     find. 18 ≈ 0.5–2 s of work for honest users, scales sub-linearly
#     for spam scripts. Set to 0 to disable PoW (handy in tests).
POW_DIFFICULTY_BITS=18

# Per-IP rate limits. Bursts are allowed up to the cap, refill at the
# corresponding rate. Tune up if legit traffic bumps these.
SIGNUP_RATE_PER_HOUR=5
LOGIN_RATE_PER_QH=20

# DEV-ONLY destructive reset. When this env var is set to the EXACT phrase
# below, the boot sequence:
#   1. Drops every domain table (users, brokerages, transactions, docs,
#      audit events).
#   2. Re-applies the schema, leaving empty tables.
#   3. Deletes every object in the storage bucket.
#
# Any other value — including "true", "1", "yes", "TRUE" — is ignored.
# The variable is named `DEV_RESET_*` so production configs don't
# accidentally include it. Never set this on a real environment.
#
#   DEV_RESET_ON_BOOT=yes-destroy-all-data
DEV_RESET_ON_BOOT=

# Document storage — any S3-compatible service. For local development run
# the rustfs container via `docker compose up rustfs` and use the defaults
# below. The legacy RUSTFS_* names still work; S3_* wins when both are set.
#
# Requests are always path-style (endpoint/bucket/key rather than
# bucket.endpoint/key), which is what self-hosted and non-AWS providers
# expect. `S3_REGION` must match whatever the provider expects even when it
# looks cosmetic — it is part of the SigV4 signature, so a wrong value is a
# signature mismatch, not a routing problem.
S3_ENDPOINT=http://127.0.0.1:37421
S3_REGION=us-east-1
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=transactvault

# Issue CreateBucket at startup. Leave true for local RustFS, which starts
# with no bucket. Set false against a managed provider where you created the
# bucket in their console: keys scoped to a single bucket answer CreateBucket
# with 403 AccessDenied, which is not the "already exists" response the
# startup check forgives, so the app would refuse to boot against a
# perfectly good bucket.
S3_AUTO_CREATE_BUCKET=true

# Browser-facing storage address, used ONLY for presigned direct-upload
# and export-download URLs. Leave unset when S3_ENDPOINT is already
# reachable from a browser (most managed providers). Set it when the app
# talks to storage over an address the browser can't — the dev compose
# stack reaches RustFS at http://rustfs:9000 while the browser needs the
# host-mapped port. The SigV4 signature covers the Host header, so a URL
# signed for the wrong one is rejected on arrival.
# S3_PUBLIC_ENDPOINT=

# Transactional email via Postmark. Leave POSTMARK_SERVER_TOKEN blank
# to disable delivery during development — outbound messages will be
# logged at INFO level instead. The "Server Token" is the per-server
# secret from postmarkapp.com → Servers → API Tokens (not the account
# API token).
#
#   POSTMARK_SERVER_TOKEN     Server-level token from the Postmark UI
#   POSTMARK_FROM             Verified Sender Signature (or domain)
#   POSTMARK_REPLY_TO         Default Reply-To (invites override per-message)
#   POSTMARK_MESSAGE_STREAM   Stream to post to; default "outbound" works
#                             for the default transactional stream
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=TransactVault <no-reply@transactvault.example>
POSTMARK_REPLY_TO=
POSTMARK_MESSAGE_STREAM=outbound

# Stripe subscription billing. Tiers are created in `/admin/tiers` and
# synced as Stripe Products + recurring Prices on save. Leave
# STRIPE_SECRET_KEY blank to disable sync — tier CRUD still works
# locally and the admin UI shows a "Stripe disabled" warning banner.
#
#   STRIPE_SECRET_KEY        sk_test_… / sk_live_…
#   STRIPE_WEBHOOK_SECRET    whsec_… — verifies /webhooks/stripe payloads
#   STRIPE_TRIAL_DAYS        free-trial length on Checkout; 0 disables
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TRIAL_DAYS=14

# Length of the card-free trial, in days, counted from a brokerage's
# FIRST transaction rather than from signup. Separate from
# STRIPE_TRIAL_DAYS: this one gates the app before any card is entered,
# and Checkout grants only whatever is left of it so the total free
# period stays this long either way.
TRIAL_DAYS=14

# Who gets an email when someone sends in-app feedback or uses the
# public contact form. Comma-separated. Leave blank to disable the
# notification — messages are still stored and visible in
# Admin → Feedback either way. Reply-To on the notification is the
# sender's own address, so replying answers them directly.
NOTIFY_EMAILS=jason@transactvault.app,chris@transactvault.app

# Boot straight into maintenance mode: every app route answers the
# "back in a few minutes" page with a 503, while the marketing pages,
# /login, /healthcheck and /admin stay reachable. This is the switch to
# set when moving servers or restoring a backup — the gate never touches
# the database, so it works when there is nothing behind the app. A
# super-admin can also toggle it live at /admin/ops without a restart,
# but while this variable is true every boot re-enters maintenance.
MAINTENANCE_MODE=false
